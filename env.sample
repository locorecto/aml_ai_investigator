# Runtime configuration
APP_NAME=aml-ai-investigator
ENVIRONMENT=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data paths
DATA_BASE_PATH=data
ARTIFACTS_PATH=artifacts

# LLM configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5
