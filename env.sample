# Runtime configuration
APP_NAME=aml-ai-investigator
ENVIRONMENT=dev
API_PREFIX=/api/v1
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Data paths
DATA_BASE_PATH=data
ARTIFACTS_PATH=artifacts

# LLM configuration
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=512
LLM_PROVIDER=openai
REQUIRED_EVIDENCE_FIELDS=
PII_REDACTION_ENABLED=false
PII_PATTERNS=\b\d{3}-\d{2}-\d{4}\b;[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,};\b\+?\d{1,3}[-. (]*\d{3}[-. )]*\d{3}[-. ]*\d{4}\b

# Cache configuration
CACHE_ENABLED=false
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
CACHE_PREFIX=aml-ai:

# Reverse proxy / gateway settings
ROOT_PATH=
PROXY_HEADERS_ENABLED=true
